{
  "manifest_version": 3,
  "name": "Vocab-track",
  "version": "0.3.0",
  "description": "Look up words while reading, and review them as flashcards.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging",
    "downloads",
    "downloads.ui",
    "alarms",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://api.datamuse.com/*",
    "https://translate.googleapis.com/*",
    "https://translation.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.languagetool.org/*",
    "https://api.giphy.com/*",
    "https://krdict.korean.go.kr/*",
    "https://www.googleapis.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "oauth2": {
    "client_id": "1041853444560-lraltlkbatonto7dn46rrsls0lfo5clc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "speed-read": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Speed-read this page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib.js",
        "lang/lang.js",
        "lang/en/irregular.js",
        "lang/en/index.js",
        "lang/ko/index.js",
        "lang/zh/index.js",
        "content-script.js",
        "reader.js",
        "writer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
